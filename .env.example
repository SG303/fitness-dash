# Directory that contains trainingsdaten.json (mounted read-only).
DATA_DIR=/path/to/Training
# Host port of the dashboard; it listens on all interfaces.
PORT=8090

# Optional Withings sync (docker compose --profile withings). Values from the
# app in the Withings developer portal; the redirect URI must match the
# registered URL exactly, e.g. https://dash.example.com/withings/callback.
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=
