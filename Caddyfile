{
	admin off
}

:80 {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
	}

	# Only this one file of the mounted data directory is reachable.
	handle /data/trainingsdaten.json {
		root * /srv
		header Cache-Control no-cache
		file_server
	}

	# Weight from the optional Withings service; 404 while it has not synced.
	handle /data/gewichtsdaten.json {
		root * /srv/weight
		uri strip_prefix /data
		header Cache-Control no-cache
		file_server
	}

	# Connection page and OAuth callback of the Withings service.
	redir /withings /withings/
	handle /withings/* {
		reverse_proxy withings:8080
	}

	handle {
		root * /srv/app
		@shell not path /assets/*
		# Page, service worker and manifest are revalidated on every load; hashed assets never change.
		header @shell Cache-Control no-cache
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
}
